# App
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cochat
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cochat
MASTER_USER_ID=1

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq (실시간 메시지 분류 LLM)
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Google (Gemini — 임베딩 전용, Groq는 임베딩 API를 제공하지 않아 병행 사용)
GOOGLE_API_KEY=
# Google이 예고 없이 특정 모델을 조기 종료하는 경우가 있어 env var로 즉시 교체 가능하게 관리
GEMINI_MODEL_NAME=gemini-3.6-flash

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cochat-for-buisness-backend.onrender.com/api/v1/integrations/discord/callback

# Slack
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://cochat-for-buisness-backend.onrender.com/api/v1/integrations/slack/callback
SLACK_SIGNING_SECRET=

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://cochat-for-buisness-backend.onrender.com/api/v1/integrations/google-calendar/callback
