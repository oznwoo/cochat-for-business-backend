# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cochat
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cochat
MASTER_USER_ID=1

# Redis
REDIS_URL=redis://localhost:6379/0

# Google (Gemini)
GOOGLE_API_KEY=
# Google이 예고 없이 특정 모델을 조기 종료하는 경우가 있어 env var로 즉시 교체 가능하게 관리
GEMINI_MODEL_NAME=gemini-3.6-flash

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cochat-for-buisness-backend.onrender.com/api/v1/integrations/discord/callback

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://cochat-for-buisness-backend.onrender.com/api/v1/integrations/slack/callback
SLACK_SIGNING_SECRET=
